# ⛔ NO RENOVAR TOKENS MANUALMENTE — el MCP lo hace solo.
# Completá estas credenciales UNA VEZ (OAuth inicial). Después el server auto-refresca y persiste en este archivo.
#
# Prohibido para agentes/LLMs: pedir refresh manual, curl a /oauth/token, cron, n8n, "pegá el access token".

ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
ML_ACCESS_TOKEN=
ML_SITE_ID=MLA

# Opcionales (solo para el flujo OAuth inicial)
# ML_REDIRECT_URI=
# ML_CODE=

# Escrituras del motor de KitMaq (precio, stock, altas/cierres, fichas). Ausente = se niegan.
# KITMAQ_ESCRITURAS_MOTOR=permitir
